// Apple Silicon fix: nf-core images are AMD64-only; force Rosetta 2 emulation explicitly
// Without this, Docker throws a platform warning and FASTQ validation can fail
// on ARM64 hosts due to subtle decompression differences under emulation.
docker.runOptions = '--platform linux/amd64'

// Nextflow 26.x broke the check_max(obj, type) function used in older nf-core pipeline configs.
// Use nf-core/rnaseq >= 3.25.0 and nf-core/fetchngs -r dev which have removed this function.
